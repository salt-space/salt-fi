PRIVATE_KEY=0xyour_evm_private_key
# PRIVATE_KEY=0xyour_other_evm_private_key

# To sign with a Ledger instead of PRIVATE_KEY (which is then ignored), uncomment
# SIGNER=ledger. LEDGER_PATH picks the account; the default is Ledger Live's first
# Ethereum account, and Ledger Live's account N is 44'/60'/N'/0/0. See README.
# SIGNER=ledger
# LEDGER_PATH=44'/60'/0'/0/0
# If the app loses your Ledger, LEDGER_DEBUG=1 prints its USB connection events:
# LEDGER_DEBUG=1

# Which Salt deployment to run against: testnet or mainnet.
# Leave SALT_ENV UNSET (as below) and the app prompts you to pick on startup —
# choosing mainnet needs an extra confirm since it moves REAL FUNDS (see README).
# To skip the prompt, uncomment the line below or use the scripts:
#   npm run dev            → prompts (testnet / mainnet)
#   npm run dev:testnet    → testnet, no prompt
#   npm run dev:mainnet    → mainnet, no prompt   (⚠ REAL FUNDS)
# SALT_ENV=testnet

# Fees (x402). Creating an account and sending a transaction cost a small USDC fee
# on networks that charge one. These choose who pays; all optional, and you can
# also switch at runtime from the "Fees (x402)" menu. See README "Fees (x402)".
#   SALT_FEE_PAYER=signer | wallet | account | none
#     signer   your signing wallet pays from its own USDC  (default on testnet)
#     wallet   a separate sponsor wallet pays              → also set SALT_FEE_PAYER_KEY
#     account  one of your Salt accounts pays (MPC)        → also set SALT_FEE_ACCOUNT_ID
#     none     nobody pays: anything that costs a fee is refused  (default on mainnet)
# SALT_FEE_PAYER=signer
# SALT_FEE_PAYER_KEY=0x...      # sponsor wallet's private key (wallet). Holds USDC; needs no gas.
# SALT_FEE_ACCOUNT_ID=          # the paying Salt account's id (account)
# SALT_FEE_CHAIN=84532          # chain to pay on, e.g. 84532 = Base Sepolia, 8453 = Base. Unset = automatic.
# SALT_FEE_MAX_USDC=25          # refuse any single payment above this many USDC
# SALT_FEE_PRESIGN=1            # sign the payment up front (one request) instead of replying to a 402
# SALT_FEE_PREFLIGHT=0          # skip checking that the payer holds the fee before paying
# SALT_FEE_STASH=0              # don't spend pre-signed payments from the stash
# Testnet USDC is paid without asking, up to SALT_FEE_MAX_USDC. Any other chain asks
# you to confirm every payment, and is refused when there's no terminal to ask on.

# Only needed for the "Policy chat" menu item (the natural-language policy agent):
ANTHROPIC_API_KEY=
