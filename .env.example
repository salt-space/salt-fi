PRIVATE_KEY=0xyour_evm_private_key
# PRIVATE_KEY=0xyour_other_evm_private_key

# Which Salt deployment to run against: testnet or mainnet.
# Leave SALT_ENV UNSET (as below) and the app prompts you to pick on startup —
# choosing mainnet needs an extra confirm since it moves REAL FUNDS (see README).
# To skip the prompt, uncomment the line below or use the scripts:
#   npm run dev            → prompts (testnet / mainnet)
#   npm run dev:testnet    → testnet, no prompt
#   npm run dev:mainnet    → mainnet, no prompt   (⚠ REAL FUNDS)
# SALT_ENV=testnet

# Only needed for the "Policy chat" menu item (the natural-language policy agent):
ANTHROPIC_API_KEY=
