{
  "name": "salt-fi",
  "version": "0.1.0",
  "description": "Rebuild of KagamiDigital/salt-autofi on Salt's new SDK.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:a": "cross-env DOTENV_CONFIG_PATH=.env.a tsx src/index.ts",
    "dev:b": "cross-env DOTENV_CONFIG_PATH=.env.b tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@clack/prompts": "^1.7.0",
    "dotenv": "^17.4.2",
    "salt-sdk": "^0.0.34",
    "viem": "^2.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
