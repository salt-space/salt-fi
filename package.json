{
  "name": "salt-fi",
  "version": "0.1.0",
  "description": "A terminal app for getting started with the Salt SDK.",
  "author": "Tamlyn Rudolph",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:a": "cross-env DOTENV_CONFIG_PATH=.env.a tsx src/index.ts",
    "dev:b": "cross-env DOTENV_CONFIG_PATH=.env.b tsx src/index.ts",
    "dev:c": "cross-env DOTENV_CONFIG_PATH=.env.c tsx src/index.ts",
    "dev:d": "cross-env DOTENV_CONFIG_PATH=.env.d tsx src/index.ts",
    "dev:testnet": "cross-env SALT_ENV=testnet tsx src/index.ts",
    "dev:mainnet": "cross-env SALT_ENV=mainnet tsx src/index.ts",
    "start": "node dist/index.js",
    "testnet-smoke": "tsx scripts/testnet-smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aleph-sdk/client": "^1.11.0",
    "@aleph-sdk/core": "^1.9.2",
    "@aleph-sdk/ethereum": "^1.9.2",
    "@aleph-sdk/message": "^1.10.0",
    "@anthropic-ai/sdk": "^0.111.0",
    "@clack/prompts": "^1.7.0",
    "@msgpack/msgpack": "^3.1.3",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "qrcode": "^1.5.4",
    "salt-sdk": "^0.0.44",
    "viem": "^2.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@ledgerhq/hw-app-eth": "^7.9.0",
    "@ledgerhq/hw-transport-node-hid-noevents": "^6.36.0"
  }
}
