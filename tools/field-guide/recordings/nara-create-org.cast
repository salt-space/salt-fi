[16.6538, "o", "\u001b[90m\u2502\u001b[39m\r\n"]
[16.7355, "o", "\u001b[35m\u25d2\u001b[39m  Registering robo host"]
[16.8152, "o", "\u001b[1G\u001b[J"]
[16.8154, "o", "\u001b[35m\u25d0\u001b[39m  Registering robo host"]
[16.9131, "o", "\u001b[1G\u001b[J\u001b[32m\u25c7\u001b[39m  Robo host registered\r\n\u001b[?25h"]
[16.9187, "o", "\u001b[?25l\u001b[90m\u2502\u001b[39m\r\n\u001b[36m\u25c6\u001b[39m  How do you want to set up this robo host?\r\n\u001b[36m\u2502\u001b[39m  \u001b[2mEsc: go back\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[32m\u25cf\u001b[39m Self-hosted install script \u001b[2m(run yourself on any Ubuntu/Debian box \u2014 validated \u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2mend-to-end)\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mAWS CloudFormation (one-click launch)\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u2191/\u2193\u001b[22m to navigate \u2022 \u001b[2mEnter:\u001b[22m confirm\r\n\u001b[36m\u2514\u001b[39m\r\n"]
[17.909, "o", "\u001b[999D\u001b[8A\u001b[1B\u001b[J"]
[17.9091, "o", "\u001b[32m\u25c7\u001b[39m  How do you want to set up this robo host?\r\n\u001b[32m\u2502\u001b[39m  \u001b[2mEsc: go back\u001b[22m\r\n\u001b[90m\u2502\u001b[39m  \u001b[2mSelf-hosted install script\u001b[22m\r\n"]
[17.9092, "o", "\u001b[?25h"]
[17.9119, "o", "\u001b[90m\u2502\u001b[39m\r\n\u001b[32m\u25c6\u001b[39m  Wrote robo-setup-nara-capital-6abd680b63af1d0023ab2f1a.sh (contains a secret OTP / one-time password \u2014 already gitignored, treat it like a credential).\r\n\u001b[90m\u2502\u001b[39m\r\n\u001b[90m\u2502\u001b[39m  This is a one-shot, fully automated script \u2014 you don't need to install\r\n\u001b[90m\u2502\u001b[39m  Docker or anything else yourself first. Just get it onto whatever\r\n\u001b[90m\u2502\u001b[39m  machine will run your Robo Guardians (a VPS, a spare box, a cloud\r\n\u001b[90m\u2502\u001b[39m  instance \u2014 anything running Ubuntu or Debian) and run it as root:\r\n\u001b[90m\u2502\u001b[39m    scp robo-setup-nara-capital-6abd680b63af1d0023ab2f1a.sh root@<your-server>:~ && ssh root@<your-server> \"chmod +x ~/robo-setup-nara-capital-6abd680b63af1d0023ab2f1a.sh && ~/robo-setup-nara-capital-6abd680b63af1d0023ab2f1a.sh\"\r\n\u001b[90m\u2502\u001b[39m\r\n\u001b[90m\u2502\u001b[39m  See docs/robo-hosting/ in this repo for platform-specific walkthroughs\r\n\u001b[90m\u2502\u001b[39m  (e.g. how to do this with only a browser-based terminal, no scp).\r\n\u001b[90m\u2502\u001b[39m\r\n\u001b[90m\u2502\u001b[39m  Once it's running, use \"Check "]
[17.912, "o", "robo status\" here to confirm it connected.\r\n"]
[17.9123, "o", "\u001b[?25l\u001b[90m\u2502\u001b[39m\r\n\u001b[36m\u25c6\u001b[39m  Organisation\r\n\u001b[36m\u2502\u001b[39m  \u001b[2mEsc: go back\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[32m\u25cf\u001b[39m Create organisation\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mInvite collaborators\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mManage collaborators\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mManage your invitations\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mList your organisations\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u2191/\u2193\u001b[22m to navigate \u2022 \u001b[2mEnter:\u001b[22m confirm\r\n\u001b[36m\u2514\u001b[39m\r\n"]
[19.4233, "o", "\u001b[999D\u001b[10A\u001b[1B"]
[19.4234, "o", "\u001b[J\u001b[31m\u25a0\u001b[39m  Organisation\r\n\u001b[31m\u2502\u001b[39m  \u001b[2mEsc: go back\u001b[22m\r\n\u001b[90m\u2502\u001b[39m  \u001b[9m\u001b[2mCreate organisation\u001b[22m\u001b[29m\r\n\u001b[90m\u2502\u001b[39m"]
[19.4234, "o", "\r\n"]
[19.4239, "o", "\u001b[?25h"]
[19.425, "o", "\u001b[?25l\u001b[90m\u2502\u001b[39m\r\n\u001b[36m\u25c6\u001b[39m  What would you like to do?\r\n\u001b[36m\u2502\u001b[39m  \u001b[2mEsc: exit\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[32m\u25cf\u001b[39m Getting started \u001b[2m(guided first-time setup)\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mOrganisation \u25b8\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mRobo Guardians \u25b8\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mAccounts \u25b8\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mAssets \u25b8\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mPolicies \u25b8\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mPrivacy (Hinkal) \u25b8\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mHyperliquid \u25b8\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mExit\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u2191/\u2193\u001b[22m to navigate \u2022 \u001b[2mEnter:\u001b[22m confirm\r\n\u001b[36m\u2514\u001b[39m\r\n"]
[20.6787, "o", "\u001b[999D\u001b[14A\u001b[1B\u001b[J\u001b[31m\u25a0\u001b[39m  What would you like to do?\r\n\u001b[31m\u2502\u001b[39m  \u001b[2mEsc: exit\u001b[22m\r\n\u001b[90m\u2502\u001b[39m  \u001b[9m\u001b[2mGetting started\u001b[22m\u001b[29m\r\n\u001b[90m\u2502\u001b[39m"]
