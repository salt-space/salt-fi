[16.7325, "o", "\u001b[?25l\u001b[90m\u2502\u001b[39m\r\n\u001b[36m\u25c6\u001b[39m  Robo Guardians\r\n\u001b[36m\u2502\u001b[39m  \u001b[2mEsc: go back\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[32m\u25cf\u001b[39m Set up Robo Guardians\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mActivate Robo Guardians (2FA)\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mCheck robo guardians\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u2191/\u2193\u001b[22m to navigate \u2022 \u001b[2mEnter:\u001b[22m confirm\r\n\u001b[36m\u2514\u001b[39m\r\n"]
[17.9312, "o", "\u001b[999D\u001b[8A\u001b[1B"]
[17.9313, "o", "\u001b[J\u001b[31m\u25a0\u001b[39m  Robo Guardians\r\n\u001b[31m\u2502\u001b[39m  \u001b[2mEsc: go back\u001b[22m\r\n\u001b[90m\u2502\u001b[39m  \u001b[9m\u001b[2mSet up Robo Guardians\u001b[22m\u001b[29m\r\n\u001b[90m\u2502\u001b[39m\r\n"]
[17.9317, "o", "\u001b[?25h"]
[17.9333, "o", "\u001b[?25l\u001b[90m\u2502\u001b[39m\r\n\u001b[36m\u25c6\u001b[39m  What would you like to do?\r\n\u001b[36m\u2502\u001b[39m  \u001b[2mEsc: exit\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[32m\u25cf\u001b[39m Getting started \u001b[2m(guided first-time setup)\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mOrganisation \u25b8\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mRobo Guardians \u25b8\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mAccounts \u25b8\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mAssets \u25b8\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mPolicies \u25b8\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mPrivacy (Hinkal) \u25b8\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mHyperliquid \u25b8\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mExit\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u2191/\u2193\u001b[22m to navigate \u2022 \u001b[2mEnter:\u001b[22m confirm\r\n\u001b[36m\u2514\u001b[39m\r\n"]
