[14.4545, "o", "\u001b[999D\u001b[8A\u001b[3B\u001b[J\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mSet up Robo Guardians\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[32m\u25cf\u001b[39m Activate Robo Guardians (2FA) \u001b[2m(required after setup \u2014 robos can't sign until \u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2mactivated)\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mCheck robo guardians\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u2191/\u2193\u001b[22m to navigate \u2022 \u001b[2mEnter:\u001b[22m confirm\r\n\u001b[36m\u2514\u001b[39m\r\n"]
