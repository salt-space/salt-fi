[8.9434, "o", "\u001b[?25h"]
[8.9437, "o", "\u001b[90m\u2502\u001b[39m\r\n\u001b[90m\u2502\u001b[39m  3/3 robo guardian(s) online:\r\n\u001b[90m\u2502\u001b[39m    \u2713 online   0x8AC6038854Bee5F565279B30Cc8B8231F2c8a5DD\r\n\u001b[90m\u2502\u001b[39m    \u2713 online   0x8cc435C40Fb8E1CA5d1F20F4fa7E8A5e3EDADb01\r\n\u001b[90m\u2502\u001b[39m    \u2713 online   0x2baEcc0D64B5ac84f128a687eB9a03112a648477\r\n"]
[8.9438, "o", "\u001b[90m\u2502\u001b[39m\r\n\u001b[33m\u25b2\u001b[39m  2FA activation: NOT complete \u2014 these robos cannot sign yet, even while online.\r\n\u001b[90m\u2502\u001b[39m  Run \"Activate Robo Guardians\" (Robo Guardians menu) to finish setup.\r\n"]
[8.9444, "o", "\u001b[?25l\u001b[90m\u2502\u001b[39m\r\n\u001b[36m\u25c6\u001b[39m  Robo Guardians\r\n\u001b[36m\u2502\u001b[39m  \u001b[2mEsc: go back\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[32m\u25cf\u001b[39m Set up Robo Guardians\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mActivate Robo Guardians (2FA)\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u25cb\u001b[22m \u001b[2mCheck robo guardians\u001b[22m\r\n\u001b[36m\u2502\u001b[39m  \u001b[2m\u2191/\u2193\u001b[22m to navigate \u2022 \u001b[2mEnter:\u001b[22m confirm\r\n\u001b[36m\u2514\u001b[39m\r\n"]
[10.0932, "o", "\u001b[999D\u001b[8A\u001b[3B\u001b[J"]
