[16.7317, "o", "\u001b[90m\u2502\u001b[39m\r\n\u001b[90m\u2502\u001b[39m  3/3 robo guardian(s) online:\r\n\u001b[90m\u2502\u001b[39m    \u2713 online   0x8AC6038854Bee5F565279B30Cc8B8231F2c8a5DD\r\n\u001b[90m\u2502\u001b[39m    \u2713 online   0x8cc435C40Fb8E1CA5d1F20F4fa7E8A5e3EDADb01\r\n\u001b[90m\u2502\u001b[39m    \u2713 online   0x2baEcc0D64B5ac84f128a687eB9a03112a648477\r\n"]
